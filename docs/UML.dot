digraph UML {
  graph [label="Projeto WAR — Diagrama de Classes UML completo (C++ / SFML, camadas Model-View-Controller)", labelloc=t, fontsize=22, fontname="DejaVu Sans", rankdir=TB, pad=0.4, nodesep=0.45, ranksep=0.9, bgcolor="#ffffff", compound=true];
  node [shape=record, style=filled, fillcolor="#ffffff", color="#334155", fontname="DejaVu Sans", fontsize=9];
  edge [fontname="DejaVu Sans", fontsize=8, color="#475569"];

  subgraph cluster_controller {
    label="controller (entrada do usuario)"; fontsize=14; style="rounded,dashed"; color="#7c3aed"; fontcolor="#7c3aed";
    ControladorJogo [fillcolor="#ede9fe", label="{ControladorJogo|- jogo: Jogo&\l- fase: Fase\l- selecionado: Territorio*\l- quantidade: int\l- mensagem: string\l- mensagemErro: bool\l- ultimoAtaque: ResultadoAtaque\l- temAtaque: bool\l- esperaBot: float\l|+ ControladorJogo(jogo: Jogo&)\l+ tratarEvento(evento: sf::Event, mouse: Vector2f, mapa: MapaView, painel: PainelView): void\l+ atualizar(segundos: float): void\l+ clicarTerritorio(id: int, botaoDireito: bool): void\l+ proximaFase(): void\l+ trocarCartas(): void\l+ mudarQuantidade(diferenca: int): void\l+ limparSelecao(): void\l+ getFase(): Fase\l+ getSelecionado(): Territorio*\l+ getQuantidade(): int\l+ getMensagem(): string\l+ mensagemEhErro(): bool\l+ temUltimoAtaque(): bool\l+ getUltimoAtaque(): ResultadoAtaque\l+ vezDoBot(): bool\l- comecarTurno(): void\l- cliqueReforco(territorio: Territorio*, todos: bool): void\l- cliqueAtaque(territorio: Territorio*): void\l- cliqueMovimento(territorio: Territorio*): void\l- avisar(texto: string, erro: bool): void\l}"];
    Fase [fillcolor="#e0e7ff", label="{«enumeration»\nFase|Reforco\lAtaque\lMovimento\l}"];
  }

  subgraph cluster_view {
    label="view (renderizacao e interface SFML, sem regras)"; fontsize=14; style="rounded,dashed"; color="#0891b2"; fontcolor="#0891b2";
    MapaView [fillcolor="#cffafe", label="{MapaView|- fontes: Fontes&\l- camera: Camera\l- regioes: RegioesMapa\l- animacoes: Animacoes\l- camadaMapa: sf::RenderTexture  «cache»\l- coresDesenhadas: vector\<Color\>\l- estados: vector\<EstadoVisual\>\l- rotasMaritimas: VertexArray\l- centros: vector\<Vector2f\>\l- continenteDe: vector\<int\>\l|+ MapaView(fontes: Fontes&, mapa: Mapa)\l+ atualizar(jogo, controlador, mouse, segundos): void\l+ desenhar(alvo, jogo, controlador, mouse): void\l+ territorioEm(pontoTela): int\l+ contem(pontoTela): bool\l+ botaoZoomEm(pontoTela): int\l+ aproximar(passos, pontoTela): void\l+ arrastar(deslocamento): void\l+ centralizar(): void\l- estadoDe(jogo, controlador, territorio): EstadoVisual\l- corDoTerritorio(...): Color\l- redesenharCamadaSeMudou(...): void\l- desenharContornos / Seta / Rotulos / Marcadores / Moldura / Dica\l}"];
    Camera [fillcolor="#cffafe", label="{Camera|- area: FloatRect\l- centro, centroAlvo: Vector2f\l- zoom, zoomAlvo: float\l|+ atualizar(segundos): void\l+ aproximar(passos, pontoTela): void\l+ arrastar(deslocamento): void\l+ centralizar(): void\l+ paraMundo(ponto): Vector2f\l+ paraTela(ponto): Vector2f\l+ visao(): sf::View\l}"];
    RegioesMapa [fillcolor="#cffafe", label="{RegioesMapa|+ ESCALA: int = 2\l- idPorPixel: vector\<int\>\l- preenchimentos: vector\<Texture\>\l- contornos: vector\<Texture\>\l- fundo, fronteiras: Texture\l|+ gerar(tamanho, centros, continenteDe, formas): void\l+ territorioEm(pontoMundo): int\l+ tocamEmTerra(a, b): bool\l+ desenharFundo / Territorio / Contorno / Fronteiras\l- distanciaAteBorda(paraTerra): vector\<int\>\l}"];
    Animacoes [fillcolor="#cffafe", label="{Animacoes|- textos, ondas, deslocamentos: vector\l- brilhos: vector\<float\>\l- tropasAntes, donosAntes: vector\l|+ observar(jogo, centros): void\l+ avancar(segundos): void\l+ criarOnda(...): void\l+ brilhoDe(id): float\l+ desenharNoMundo / desenharNaTela\l}"];
    PainelView [fillcolor="#cffafe", label="{PainelView|- fontes: Fontes&\l- botaoMenos, botaoMais, botaoTrocar, botaoProxima: FloatRect\l|+ desenhar(alvo, jogo, controlador, mouse): void\l+ desenharVitoria(alvo, jogo): void\l+ acaoEm(ponto): AcaoPainel\l- desenharCabecalho / Continentes / Acoes / Botao\l}"];
    EventosView [fillcolor="#cffafe", label="{EventosView|- fontes: Fontes&\l|+ desenhar(alvo, jogo): void\l- tipoDoEvento(texto): TipoIcone\l}"];
    BarraSuperiorView [fillcolor="#cffafe", label="{BarraSuperiorView|- fontes: Fontes&\l- turnoVisto: int\l- tempoFaixa, duracaoFaixa: float\l|+ atualizar(jogo, segundos): void\l+ desenhar(alvo, jogo, controlador): void\l+ desenharFaixaDeTurno(alvo, jogo): void\l}"];
    Fontes [fillcolor="#e0f2fe", label="{«struct»\nFontes|+ normal, medio, negrito, titulo: sf::Font\l|+ carregar(pasta: string): void\l}"];
    AcaoPainel [fillcolor="#e0e7ff", label="{«enumeration»\nAcaoPainel|Nenhuma\lMenos\lMais\lTrocar\lProximaFase\l}"];
    EstadoVisual [fillcolor="#e0e7ff", label="{«enumeration»\nEstadoVisual|Normal\lProibido\lPossivel\lSelecionado\l}"];
    TipoIcone [fillcolor="#e0e7ff", label="{«enumeration»\nTipoIcone|Ataque\lConquista\lMovimento\lReforco\lCartas\lEliminacao\lVitoria\lTurno\l}"];
  }

  subgraph cluster_model {
    label="model (regras do jogo)"; fontsize=14; style="rounded,dashed"; color="#2563eb"; fontcolor="#2563eb";
    Jogo [fillcolor="#dbeafe", label="{Jogo|- mapa: Mapa\l- jogadores: vector\<unique_ptr\<Jogador\>\>\l- baralho: vector\<Carta\>\l- gerador: mt19937\l- jogadorAtual: int\l- turno: int\l- trocasRealizadas: int\l- conquistouNoTurno: bool\l- fim: bool\l- vencedor: Jogador*\l- historico: vector\<string\>\l|+ Jogo(nomes: vector\<string\>, quantidadeHumanos: int, semente: unsigned int)\l+ executar(maxTurnos: int): void\l+ iniciarTurno(): int\l+ finalizarTurno(): void\l+ atacar(atacante: Jogador*, origem: Territorio*, alvo: Territorio*, dados: int): ResultadoAtaque\l+ trocarCartas(jogador: Jogador*): int\l+ encerrar(): void\l+ registrarEvento(texto: string): void\l+ getMapa(): Mapa&\l+ terminou(): bool\l+ getVencedor(): Jogador*\l+ getQuantidadeJogadores(): int\l+ getJogador(indice: int): Jogador*\l+ getJogadorAtual(): Jogador*\l+ getTurno(): int\l+ getHistorico(): vector\<string\>\l- distribuirTerritorios(): void\l- criarBaralho(): void\l- sortearObjetivos(): void\l- calcularReforcos(jogador: Jogador*): int\l- verificarVitoria(jogador: Jogador*): void\l- rolarDados(quantidade: int): vector\<int\>\l}"];
    ResultadoAtaque [fillcolor="#e0e7ff", label="{«struct»\nResultadoAtaque|+ dadosAtaque: vector\<int\>\l+ dadosDefesa: vector\<int\>\l+ perdasAtaque: int\l+ perdasDefesa: int\l+ conquistou: bool\l}"];
    Mapa [fillcolor="#dbeafe", label="{Mapa|- territorios: vector\<unique_ptr\<Territorio\>\>\l- continentes: vector\<unique_ptr\<Continente\>\>\l|+ Mapa()\l+ getQuantidadeTerritorios(): int\l+ getTerritorio(id: int): Territorio*\l+ getQuantidadeContinentes(): int\l+ getContinente(indice: int): Continente*\l+ mostrar(): void\l- criarContinente(nome: string, bonus: int, nomes: vector\<string\>): void\l- conectar(primeiro: string, segundo: string): void\l- buscarPorNome(nome: string): Territorio*\l}"];
    Continente [label="{Continente|- nome: string\l- bonus: int\l- territorios: vector\<Territorio*\>\l|+ Continente(nome: string, bonus: int)\l+ getNome(): string\l+ getBonus(): int\l+ adicionarTerritorio(territorio: Territorio*): void\l+ controladoPor(jogador: Jogador*): bool\l}"];
    Territorio [label="{Territorio|- id: int\l- nome: string\l- tropas: int\l- tropasRecebidas: int\l- dono: Jogador*\l- vizinhos: vector\<Territorio*\>\l|+ Territorio(id: int, nome: string)\l+ getId(): int\l+ getNome(): string\l+ getTropas(): int\l+ getTropasRecebidas(): int\l+ getDono(): Jogador*\l+ getVizinhos(): vector\<Territorio*\>\l+ setDono(novoDono: Jogador*): void\l+ adicionarTropas(quantidade: int): void\l+ removerTropas(quantidade: int): void\l+ registrarTropasRecebidas(quantidade: int): void\l+ zerarTropasRecebidas(): void\l+ adicionarVizinho(outro: Territorio*): void\l+ ehVizinho(outro: Territorio*): bool\l}"];
    Carta [label="{Carta|- territorio: string\l- tipo: TipoCarta\l|+ Carta(territorio: string, tipo: TipoCarta)\l+ getTerritorio(): string\l+ getTipo(): TipoCarta\l+ descricao(): string\l}"];
    TipoCarta [fillcolor="#e0e7ff", label="{«enumeration»\nTipoCarta|Infantaria\lCavalaria\lArtilharia\l}"];
    Jogador [fillcolor="#dcfce7", label="{«abstract»\nJogador|- nome: string\l- cor: string\l- exercitos: int\l- territorios: vector\<Territorio*\>\l- cartas: vector\<Carta\>\l- objetivo: unique_ptr\<Objetivo\>\l- eliminadoPor: Jogador*\l|+ Jogador(nome: string, cor: string)\l+ ~Jogador() «virtual»\l+ jogarTurno(jogo: Jogo&): void «abstract»\l+ ehAutomatico(): bool «virtual»\l+ getNome(): string\l+ getCor(): string\l+ getExercitos(): int\l+ getQuantidadeTerritorios(): int\l+ getTerritorios(): vector\<Territorio*\>\l+ getCartas(): vector\<Carta\>\l+ getObjetivo(): Objetivo*\l+ getEliminadoPor(): Jogador*\l+ estaAtivo(): bool\l+ possui(territorio: Territorio*): bool\l+ getTotalTropas(): int\l+ podeAtacar(origem: Territorio*, alvo: Territorio*): bool\l+ podeMover(origem: Territorio*, destino: Territorio*): bool\l+ setObjetivo(novoObjetivo: Objetivo*): void\l+ setEliminadoPor(jogador: Jogador*): void\l+ receberExercitos(quantidade: int): void\l+ colocarExercitos(territorio: Territorio*, quantidade: int): void\l+ moverTropas(origem: Territorio*, destino: Territorio*, quantidade: int): void\l+ conquistar(territorio: Territorio*): void\l+ receberCarta(carta: Carta): void\l+ podeTrocarCartas(): bool\l+ trocarCartas(): vector\<Carta\>\l+ entregarCartasPara(outro: Jogador*): void\l- removerCartaDoTipo(tipo: TipoCarta): Carta\l}"];
    JogadorHumano [fillcolor="#dcfce7", label="{JogadorHumano|+ JogadorHumano(nome: string, cor: string)\l+ jogarTurno(jogo: Jogo&): void\l- lerLinha(prompt: string): string\l- comandoGeral(jogo: Jogo&, comando: string, entrada: istringstream&): bool\l- mostrarStatus(): void\l- faseReforco(jogo: Jogo&): void\l- faseAtaque(jogo: Jogo&): void\l- faseMovimento(jogo: Jogo&): void\l}"];
    JogadorBot [fillcolor="#dcfce7", label="{JogadorBot|+ JogadorBot(nome: string, cor: string)\l+ jogarTurno(jogo: Jogo&): void\l+ ehAutomatico(): bool\l- ehFronteira(territorio: Territorio*): bool\l- reforcar(): void\l- atacar(jogo: Jogo&): void\l- mover(): void\l}"];
    Objetivo [fillcolor="#fef3c7", label="{«abstract»\nObjetivo|+ ~Objetivo() «virtual»\l+ foiCumprido(jogador: Jogador*): bool «abstract»\l+ descricao(): string «abstract»\l}"];
    ObjetivoTerritorios [fillcolor="#fef3c7", label="{ObjetivoTerritorios|- quantidade: int\l|+ ObjetivoTerritorios(quantidade: int)\l+ foiCumprido(jogador: Jogador*): bool\l+ descricao(): string\l}"];
    ObjetivoContinentes [fillcolor="#fef3c7", label="{ObjetivoContinentes|- primeiro: Continente*\l- segundo: Continente*\l|+ ObjetivoContinentes(primeiro: Continente*, segundo: Continente*)\l+ foiCumprido(jogador: Jogador*): bool\l+ descricao(): string\l}"];
    ObjetivoEliminar [fillcolor="#fef3c7", label="{ObjetivoEliminar|- alvo: Jogador*\l- territoriosAlternativo: int\l|+ ObjetivoEliminar(alvo: Jogador*, territoriosAlternativo: int)\l+ foiCumprido(jogador: Jogador*): bool\l+ descricao(): string\l}"];
    WarException [fillcolor="#fee2e2", label="{WarException|+ WarException(mensagem: string)\l}"];
    runtime_error [fillcolor="#f1f5f9", label="{std::runtime_error|+ what(): const char*\l}"];
  }

  // ---------- Heranca ----------
  edge [arrowhead=onormal, style=solid];
  JogadorHumano -> Jogador;
  JogadorBot -> Jogador;
  ObjetivoTerritorios -> Objetivo;
  ObjetivoContinentes -> Objetivo;
  ObjetivoEliminar -> Objetivo;
  WarException -> runtime_error;

  // ---------- Composicao ----------
  edge [dir=back, arrowtail=diamond, arrowhead=none, style=solid];
  Jogo -> Mapa [taillabel="1", headlabel="1"];
  Jogo -> Jogador [taillabel="1", headlabel="2..6"];
  Jogo -> Carta [taillabel="1", headlabel="0..42", label=" baralho"];
  Mapa -> Territorio [taillabel="1", headlabel="42"];
  Mapa -> Continente [taillabel="1", headlabel="6"];
  Jogador -> Objetivo [taillabel="1", headlabel="1"];
  Jogador -> Carta [taillabel="1", headlabel="0..*", label=" mao"];
  ControladorJogo -> ResultadoAtaque [taillabel="1", headlabel="1", label=" ultimoAtaque"];
  MapaView -> Camera [taillabel="1", headlabel="1"];
  MapaView -> RegioesMapa [taillabel="1", headlabel="1"];
  MapaView -> Animacoes [taillabel="1", headlabel="1"];

  // ---------- Agregacao ----------
  edge [dir=back, arrowtail=odiamond, arrowhead=none];
  Continente -> Territorio [taillabel="1", headlabel="1..*"];

  // ---------- Associacoes ----------
  edge [dir=forward, arrowhead=vee, arrowtail=none, style=solid];
  Jogador -> Territorio [label=" territorios", headlabel="0..*"];
  Territorio -> Jogador [label=" dono", headlabel="0..1"];
  Territorio -> Territorio [label=" vizinhos", headlabel="1..*"];
  Jogador -> Jogador [label=" eliminadoPor", headlabel="0..1"];
  Jogo -> Jogador [label=" vencedor", headlabel="0..1"];
  ObjetivoContinentes -> Continente [headlabel="2"];
  ObjetivoEliminar -> Jogador [label=" alvo", headlabel="1"];
  Carta -> TipoCarta [label=" tipo"];
  ControladorJogo -> Jogo [label=" jogo", headlabel="1"];
  ControladorJogo -> Territorio [label=" selecionado", headlabel="0..1"];
  ControladorJogo -> Fase [label=" fase"];

  // ---------- Dependencias ----------
  edge [style=dashed, arrowhead=vee];
  Jogo -> ResultadoAtaque [label=" «create»"];
  Jogo -> WarException [label=" «throw»"];
  Jogador -> Jogo [label=" «use»"];
  Jogador -> WarException [label=" «throw»"];
  Territorio -> WarException [label=" «throw»"];
  Mapa -> WarException [label=" «throw»"];
  ControladorJogo -> MapaView [label=" «use» territorioEm"];
  ControladorJogo -> PainelView [label=" «use» acaoEm"];
  ControladorJogo -> WarException [label=" «catch»"];
  MapaView -> Jogo [label=" «read»"];
  MapaView -> EstadoVisual;
  EventosView -> TipoIcone;
  MapaView -> Fontes [label=" usa"];
  PainelView -> Fontes [label=" usa"];
  EventosView -> Fontes [label=" usa"];
  BarraSuperiorView -> Fontes [label=" usa"];
  BarraSuperiorView -> Jogo [label=" «read»"];
  BarraSuperiorView -> ControladorJogo [label=" «read»"];
  MapaView -> ControladorJogo [label=" «read»"];
  PainelView -> Jogo [label=" «read»"];
  PainelView -> ControladorJogo [label=" «read»"];
  PainelView -> AcaoPainel;
}
