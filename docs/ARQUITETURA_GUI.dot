digraph UiWar {
    graph [fontname="Arial", bgcolor="#112034", labelloc=t,
           label="WAR — separacao entre interface 2D e motor POO", fontcolor="#f2dfba", ranksep=1.0];
    node [fontname="Arial", shape=record, style="filled,rounded", fillcolor="#26384e", color="#a6bbc7", fontcolor="#ffffff"];
    edge [fontname="Arial", color="#e9c27f", fontcolor="#ffffff"];
    Ui [label="{Ui (GUI raylib)|- quantidadeJogadores : int\l- jogo : unique_ptr\<Jogo\>\l- origem, destino : int\l- quantidade, dados : int\l- mensagem : string\l|+ iniciar()\l+ selecionar(id)\l+ acao()\l+ avancar()\l+ notificar(msg)\l}"];
    Jogo [label="{Jogo (war_core)|+ mapa() : Mapa\l+ jogadorAtual() : Jogador\l+ fase() : FaseTurno\l|+ iniciarTurnoAtual()\l+ reforcar()\l+ atacarTerritorio()\l+ moverTropas()\l+ trocarCartas()\l+ avancarFase()\l}"];
    Mapa [label="{Mapa|+ todosTerritorios()\l}"];
    Jogador [label="{Jogador|+ territorios()\l+ exercitosDisponiveis()\l}"];
    Territorio [label="{Territorio|+ tropas()\l+ dono()\l+ vizinhos()\l}"];
    Raylib [shape=box, label="raylib\n(renderizacao e eventos)",fillcolor="#176356"];
    Ui -> Jogo [label="chama API publica / compoe", arrowhead=diamond, dir=both];
    Ui -> Raylib [label="desenha e recebe clicks"];
    Jogo -> Mapa;
    Jogo -> Jogador;
    Mapa -> Territorio;
}
